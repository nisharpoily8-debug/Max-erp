# ==============================================================================
# Maxerp Production Environment Configuration
# Hostinger Node.js Web Apps & Supabase PostgreSQL
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
# Port assigned dynamically by Hostinger Node.js Application Manager (defaults to 3000)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# Obtain from your Supabase Dashboard: Project Settings -> Database -> Connection string
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection URI (with SSL enabled):
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase API credentials (obtain from Project Settings -> API)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# AI & Optical Character Recognition (OCR) Service
# ------------------------------------------------------------------------------
# Google Gemini API key for optical invoice scanning and automated bill extraction
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Application Public URL
# ------------------------------------------------------------------------------
APP_URL=https://your-domain.com
